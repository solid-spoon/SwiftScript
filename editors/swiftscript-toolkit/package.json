{
  "name": "swiftscript-toolkit",
  "displayName": "SwiftScript Toolkit",
  "description": "Syntax, snippets, outline, folding, hover, completion and diagnostics for SwiftScript",
  "version": "0.3.0",
  "publisher": "swiftscript",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/solid-spoon/SwiftScript"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./out/extension.js",
  "type": "module",
  "activationEvents": [
    "onLanguage:swiftscript"
  ],
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "swiftscript",
        "aliases": [
          "SwiftScript",
          "swiftscript",
          "sws"
        ],
        "extensions": [
          ".sws"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "icon.png",
          "dark": "icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "swiftscript",
        "scopeName": "source.swiftscript",
        "path": "./syntaxes/swiftscript.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "swiftscript",
        "path": "./snippets/swiftscript.json"
      }
    ],
    "configuration": {
      "title": "SwiftScript",
      "properties": {
        "swiftscript.compilerPath": {
          "type": "string",
          "default": "./swsc",
          "description": "Path to the swsc compiler executable."
        }
      }
    }
  }
}