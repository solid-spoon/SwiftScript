// SwiftScript Explorer — TreeView with nested structure
// Run: swsc build src -o out
// Then F5 in VSCode Extension Development Host

import * as vscode from "vscode"

enum SymbolKind {
    case enumDecl
    case structDecl
    case classDecl
    case funcDecl
    case letDecl
}

enum NodeKind {
    case file
    case symbol
}

class TreeNode {
    let label: String
    let nodeKind: NodeKind

    init(label: String, nodeKind: NodeKind) {
        self.label = label
        self.nodeKind = nodeKind
    }
}

class SymbolNode extends TreeNode {
    let symbolKind: SymbolKind
    let line: Int
    let uri: Any
    let isBlock: Bool
    var depth: Int
    var children: [SymbolNode]

    init(label: String, symbolKind: SymbolKind, line: Int, uri: Any, isBlock: Bool) {
        super.init(label: label, nodeKind: .symbol)
        self.symbolKind = symbolKind
        self.line = line
        self.uri = uri
        self.isBlock = isBlock
        self.depth = 0
        self.children = []
    }
}

class FileNode extends TreeNode {
    let uri: Any
    let symbols: [SymbolNode]

    init(label: String, uri: Any, symbols: [SymbolNode]) {
        super.init(label: label, nodeKind: .file)
        self.uri = uri
        self.symbols = symbols
    }
}

func iconFor(kind: SymbolKind) -> String {
    switch kind {
    case .enumDecl:   return "symbol-enum"
    case .structDecl: return "symbol-struct"
    case .classDecl:  return "symbol-class"
    case .funcDecl:   return "symbol-method"
    case .letDecl:    return "symbol-variable"
    }
    return "symbol-misc"
}

func stripComment(line: String) -> String {
    let pos = line.indexOf("//")
    if pos >= 0 {
        return line.substring(0, pos)
    }
    return line
}

func countBraces(line: String, brace: String) -> Int {
    let parts = line.split(brace)
    return parts.length - 1
}

func parseDecl(t: String, originalLine: Int, uri: Any) -> SymbolNode? {
    let rawWords = t.split(" ")
    var words: [String] = []
    for w in rawWords {
        if w.length > 0 {
            words.push(w)
        }
    }

    var kind: SymbolKind? = nil
    var idx = 0

    for w in words {
        if w == "enum" { kind = .enumDecl; break }
        if w == "struct" { kind = .structDecl; break }
        if w == "class" { kind = .classDecl; break }
        if w == "func" { kind = .funcDecl; break }
        if w == "let" || w == "var" { kind = .letDecl; break }

        // skip modifiers
        if w == "export" || w == "private" || w == "public" || w == "internal" || w == "static" || w == "async" || w == "override" || w == "lazy" {
            idx += 1
            continue
        }
        return nil
    }

    if kind == nil { return nil }
    if idx + 1 >= words.length { return nil }

    var name = words[idx + 1]
    name = name.split("(")[0]
    name = name.split("{")[0]
    name = name.split(":")[0]
    name = name.trim()

    let kindStr = words[idx]
    let label = "\(kindStr) \(name)"
    let k = kind!
    let isBlock = (k == .enumDecl || k == .structDecl || k == .classDecl || k == .funcDecl)

    return new SymbolNode(label: label, symbolKind: k, line: originalLine, uri: uri, isBlock: isBlock)
}

func parseNestedSymbols(text: String, uri: Any) -> [SymbolNode] {
    var result: [SymbolNode] = []
    var stack: [SymbolNode] = []
    let lines = text.split("\n")
    var lineNo = 1
    var currentDepth = 0

    for line in lines {
        let code = stripComment(line: line)
        let t = code.trim()
        if t.length > 0 {
            let opens = countBraces(line: t, brace: "{")
            let closes = countBraces(line: t, brace: "}")

            if let n = parseDecl(t: t, originalLine: lineNo, uri: uri) {
                while stack.length > 0 && stack[stack.length - 1].depth >= currentDepth {
                    stack.pop()
                }
                if stack.length > 0 {
                    stack[stack.length - 1].children.push(n)
                } else {
                    result.push(n)
                }

                if n.isBlock && opens > closes {
                    n.depth = currentDepth
                    stack.push(n)
                }
            }

            currentDepth += opens - closes
        }
        lineNo += 1
    }
    return result
}

class SwiftScriptTreeProvider implements vscode.TreeDataProvider {
    let _onDidChangeTreeData: Any
    let onDidChangeTreeData: Any
    var files: [FileNode] = []
    var loaded: Bool = false

    init() {
        self._onDidChangeTreeData = new vscode.EventEmitter()
        self.onDidChangeTreeData = self._onDidChangeTreeData.event
    }

    func refresh() {
        self.loaded = false
        self._onDidChangeTreeData.fire()
    }

    async func load() {
        if self.loaded {
            return
        }
        let uris = await vscode.workspace.findFiles("**/*.sws")
        var result: [FileNode] = []
        for uri in uris {
            try {
                let doc = await vscode.workspace.openTextDocument(uri)
                let text = doc.getText()
                let symbols = parseNestedSymbols(text: text, uri: uri)
                let rel = vscode.workspace.asRelativePath(uri)
                result.push(new FileNode(label: rel, uri: uri, symbols: symbols))
            } catch e {
                // skip unreadable files
            }
        }
        self.files = result
        self.loaded = true
    }

    func getTreeItem(element: Any) -> Any {
        var hasChildren = false
        if element.nodeKind == .symbol && element.children.length > 0 {
            hasChildren = true
        }

        let collapsible = (element.nodeKind == .file || hasChildren)
            ? vscode.TreeItemCollapsibleState.Collapsed
            : vscode.TreeItemCollapsibleState.None

        let item = new vscode.TreeItem(element.label, collapsible)

        if element.nodeKind == .file {
            item.iconPath = new vscode.ThemeIcon("file-code")
            item.contextValue = "swiftscriptFile"
            item.tooltip = element.label
        } else {
            item.iconPath = new vscode.ThemeIcon(iconFor(kind: element.symbolKind))
            item.contextValue = "swiftscriptSymbol"
            item.command = [
                "command": "swiftscriptExplorer.openSymbol",
                "title": "Open",
                "arguments": [element]
            ]
        }

        return item
    }

    async func getChildren(element: Any?) -> [Any] {
        if element == nil {
            await self.load()
            return self.files
        }
        if element.nodeKind == .file {
            return element.symbols
        }
        if element.nodeKind == .symbol && element.children.length > 0 {
            return element.children
        }
        return []
    }
}

export func activate(context: Any) {
    let provider = new SwiftScriptTreeProvider()
    let treeView = vscode.window.createTreeView("swiftscriptExplorer", [
        "treeDataProvider": provider,
        "showCollapseAll": true
    ])
    context.subscriptions.push(treeView)

    let refreshCmd = vscode.commands.registerCommand("swiftscriptExplorer.refresh", {
        provider.refresh()
    })
    context.subscriptions.push(refreshCmd)

    let openCmd = vscode.commands.registerCommand("swiftscriptExplorer.openSymbol", { async node in
        if node.nodeKind == .symbol {
            let line = node.line - 1
            let pos = new vscode.Position(line, 0)
            let range = new vscode.Range(pos, pos)
            await vscode.window.showTextDocument(node.uri, [
                "selection": range
            ])
        }
    })
    context.subscriptions.push(openCmd)

    let watcher = vscode.workspace.createFileSystemWatcher("**/*.sws")
    watcher.onDidChange({ _ in provider.refresh() })
    watcher.onDidCreate({ _ in provider.refresh() })
    watcher.onDidDelete({ _ in provider.refresh() })
    context.subscriptions.push(watcher)
}

export func deactivate() {
}